# Copy this to .env and fill in your values. Never commit .env to git.
#
# How to get these values:
#   1. Create a Polymarket account at polymarket.com
#   2. Deposit USDC on Polygon network
#   3. Go to polymarket.com → Profile → API Keys → Generate
#   4. POLY_FUNDER_ADDRESS = your Polygon wallet address
#   5. POLY_SIGNATURE_TYPE = 1 (standard EOA wallet like MetaMask)

POLY_PRIVATE_KEY=0x...         # Your Polygon private key (keep this secret!)
POLY_API_KEY=                  # From Polymarket API settings
POLY_API_SECRET=               # From Polymarket API settings
POLY_API_PASSPHRASE=           # From Polymarket API settings
POLY_FUNDER_ADDRESS=0x...      # Your Polygon wallet address
POLY_SIGNATURE_TYPE=1          # 1 for EOA wallet (MetaMask etc.)

# Optional: Discord webhook for notifications
DISCORD_WEBHOOK=

# Copy this file to .env and fill in your values
# Never commit .env to git

# Polymarket CLOB API credentials (get from polymarket.com → API settings)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=

# Set to false for real trading (default: true = testnet)
TESTNET_MODE=true

# Strategy thresholds (optional — these are the defaults)
MOMENTUM_BUY_THRESHOLD=0.05
MOMENTUM_SELL_THRESHOLD=-0.05
MIN_CONFIDENCE=0.6
BASE_POSITION_SIZE=10.0
MAX_POSITION_SIZE=50.0

# Risk limits
MAX_DAILY_LOSS=100.0
MAX_TOTAL_EXPOSURE=500.0
MAX_PER_MARKET=100.0
STOP_LOSS_PCT=0.20

# Execution
UPDATE_INTERVAL_SECONDS=10
